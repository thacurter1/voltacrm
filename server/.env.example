# ==============================================================================
# CONFIGURAZIONE VOLTACRM BACKEND API STANDALONE (PRODUZIONE & LOCALE)
# ==============================================================================

# Porta di ascolto del server Express
PORT=5000

# Chiave segreta per la firma crittografica dei JWT
JWT_SECRET=inserisci_una_chiave_segreta_lunga_e_complessa_qui_sha256

# Domini ammessi per il CORS (separati da virgola)
# Esempio: http://localhost:5173,https://crm.voltacrm.it,https://cliente.voltacrm.it,https://totem.voltacrm.it
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://voltacrm.vercel.app

# Credenziali PostgreSQL / Supabase per la persistenza reale dei dati
# Ottenibili dal pannello Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini API Key per OCR Multimodale 2.5 Flash sulle Bollette ARERA
GEMINI_API_KEY=AIzaSy...

# Provider Messaggistica SMS & WhatsApp (Opzionale - attiva Dev Sandbox Mode se omessi)
# 1. Configurazione Twilio (SMS & WhatsApp Business)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+14155238886

# 2. Configurazione Meta WhatsApp Cloud API (Opzionale)
WHATSAPP_CLOUD_API_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=100000000000000
