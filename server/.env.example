# ==============================================================================
# CONFIGURAZIONE VOLTACRM BACKEND API STANDALONE (PRODUZIONE & LOCALE)
# ==============================================================================

# Porta di ascolto del server Express
PORT=5000

# Chiave segreta per la firma crittografica dei JWT
JWT_SECRET=inserisci_una_chiave_segreta_lunga_e_complessa_qui_sha256

# Domini ammessi per il CORS (separati da virgola)
# Esempio: http://localhost:5173,https://crm.voltacrm.it,https://cliente.voltacrm.it,https://totem.voltacrm.it
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://voltacrm.vercel.app

# Credenziali PostgreSQL / Supabase per la persistenza reale dei dati
# Ottenibili dal pannello Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
