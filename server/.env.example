# ==============================================================================
# VoltaCRM SaaS — Configurazione Backend Express (.env.example)
# Copia questo file in server/.env e compila con i tuoi parametri segreti.
# ==============================================================================

# Porta del server Express
PORT=5000

# Domini frontend abilitati per CORS (separati da virgola)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Chiave segreta per la firma dei token JWT di sessione operatore
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Supabase Server SDK (Service Role per bypass RLS backend e Anon per client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-secret
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini Vision API per OCR intelligente bollette energetiche (PDF / Immagini)
GEMINI_API_KEY=your-gemini-api-key

# Provider SMS & WhatsApp — Twilio
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+39XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Provider WhatsApp Ufficiale — Meta WhatsApp Cloud API
WHATSAPP_CLOUD_API_TOKEN=your-meta-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
