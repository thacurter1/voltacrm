# ==============================================================================
# VoltaCRM SaaS — Configurazione Backend Express (.env.example)
# Copia questo file in server/.env e compila con i tuoi parametri segreti.
# ==============================================================================

# Modalità runtime. In produzione lascia sempre VOLTA_DEMO_MODE=false.
NODE_ENV=production
VOLTA_DEMO_MODE=false

# Porta del server Express
PORT=5000

# Domini frontend abilitati per CORS (separati da virgola)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Chiave segreta per la firma dei token JWT di sessione operatore
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Devono coincidere con i client ID OAuth usati dal frontend.
GOOGLE_OAUTH_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
APPLE_OAUTH_CLIENT_ID=your-apple-services-id

# Bootstrap iniziale amministratore (obbligatorio fuori dalla modalità demo)
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-password-at-least-12-chars
ADMIN_2FA_SECRET=replace-with-a-unique-totp-secret-at-least-20-chars

# Supabase Server SDK (Progetto: wobbcdurpamtbkicqzhx)
SUPABASE_URL=https://wobbcdurpamtbkicqzhx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-secret
SUPABASE_ANON_KEY=your-supabase-anon-key

# Facoltativo: ometti per disabilitare il gateway Totem
TOTEM_KIOSK_API_KEY=replace-with-a-unique-key-at-least-32-chars

# Google Gemini Vision API per OCR intelligente bollette energetiche (PDF / Immagini)
GEMINI_API_KEY=your-gemini-api-key

# Provider SMS & WhatsApp — Twilio
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+39XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Provider WhatsApp Ufficiale — Meta WhatsApp Cloud API
WHATSAPP_CLOUD_API_TOKEN=your-meta-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
