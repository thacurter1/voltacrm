# ==============================================================================
# VoltaCRM SaaS — Configurazione Backend Express di Produzione (.env.production.example)
# Copia questo file in server/.env nel tuo ambiente di hosting (Render, Fly, VPS).
# COMPILA TUTTI I VALORI CON CREDENZIALI DI PRODUZIONE REALI E RISERVATE.
# ==============================================================================

# Runtime Environment
NODE_ENV=production
# In produzione deve essere categoricamente false.
# Con false, tutte le operazioni di scrittura, persistenza lead e contratti usano Supabase.
VOLTA_DEMO_MODE=false

# Porta del server HTTP
PORT=5000

# Domini Frontend autorizzati per le chiamate CORS (separati da virgola, senza trailing slash)
# Esempio: https://voltacrm.it,https://app.voltacrm.it
CORS_ORIGIN=https://voltacrm.it,https://app.voltacrm.it

# Chiave crittografica per la firma dei token di sessione JWT (MINIMO 32 caratteri casuali ed esadecimali/alfanumerici)
# Generabile con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generare-una-stringa-sicura-lunga-almeno-32-caratteri-random

# Client ID OAuth (devono coincidere con i valori configurati nel frontend e nelle console Google/Apple)
GOOGLE_OAUTH_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
APPLE_OAUTH_CLIENT_ID=your-apple-services-id

# ==============================================================================
# Bootstrap Iniziale Account Amministratore (Owner / Admin)
# Obbligatorio al primo avvio in produzione se il database è vuoto.
# L'amministratore verrà registrato in crm_accounts con 2FA TOTP abilitata.
# ==============================================================================
ADMIN_EMAIL=amministrazione@voltacrm.it
ADMIN_INITIAL_PASSWORD=ScegliereUnaPassphraseUnivoca2026!#
# Chiave segreta Base32 per Google Authenticator / Authy (minimo 20 caratteri, es. JBSWY3DPEHPK3PXP...)
# Non deve contenere la parola VOLTA_
ADMIN_2FA_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# ==============================================================================
# Connessione Database Supabase (Progetto Volta CRM)
# Configurare l'URL e UNA chiave privata privilegiata (SUPABASE_SECRET_KEY o SUPABASE_SERVICE_ROLE_KEY).
# IMPORTANTE: NON usare MAI qui la chiave anon/publishable!
# ==============================================================================
SUPABASE_URL=https://wobbcdurpamtbkicqzhx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...inserire-la-chiave-service-role-da-supabase-settings-api

# ==============================================================================
# Gateway Postazione Totem Kiosk Interattiva (Opzionale)
# ==============================================================================
# Chiave API per l'inoltro dei contatti acquisiti dal totem (minimo 32 caratteri)
TOTEM_KIOSK_API_KEY=stringa-segreta-univoca-totem-minimo-32-caratteri
# Chiave registrata sul browser kiosk touch per identificare la postazione fisica
TOTEM_KIOSK_DEVICE_KEY=chiave-dispositivo-fisico-kiosk-distinta-dalla-api-key

# ==============================================================================
# Intelligenza Artificiale per OCR Analisi Bollette (Opzionale ma Raccomandato)
# Google Gemini Vision API per l'estrazione automatica di consumi (kWh/Smc), POD, PDR e spese
# ==============================================================================
GEMINI_API_KEY=AIzaSy...tua-chiave-gemini-vision-api

# ==============================================================================
# Notifiche e Outreach Lead (WhatsApp & SMS)
# Scegliere Meta Cloud API ufficiale o Twilio per l'invio automatizzato
# ==============================================================================
# Meta WhatsApp Cloud API ufficiale (Raccomandato per produzione)
WHATSAPP_CLOUD_API_TOKEN=EAA...token-permanente-meta-graph-api
WHATSAPP_PHONE_NUMBER_ID=100000000000000

# Provider Alternativo SMS/WhatsApp — Twilio
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+390200000000
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
