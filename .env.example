# ==============================================================================
# VoltaCRM SaaS — Configurazione Frontend (.env.example)
# Copia questo file in .env e compila con i tuoi parametri.
# ==============================================================================

# URL endpoint REST del backend Express (in dev: http://localhost:5000/api)
VITE_API_URL=http://localhost:5000/api

# Abilita account e scorciatoie demo solo per demo locali dedicate
VITE_DEMO_MODE=false

# ID pubblici dei client OAuth configurati presso Google e Apple.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_APPLE_CLIENT_ID=your-apple-services-id

# Supabase Auth & Realtime Database (Progetto: wobbcdurpamtbkicqzhx)
VITE_SUPABASE_URL=https://wobbcdurpamtbkicqzhx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Hostname dedicato al Totem (solo nome host, es. voltacrm-totem.vercel.app).
# IMPORTANTE: NON inserire mai la chiave segreta TOTEM_KIOSK_DEVICE_KEY in variabili VITE_*.
# La chiave TOTEM_KIOSK_DEVICE_KEY va configurata solo sul backend Render e inserita una tantum nel browser della postazione.
# VITE_TOTEM_HOSTNAME=voltacrm-totem.vercel.app

# Identità societaria completa per rimuovere il banner dimostrativo nel footer legale
# VITE_COMPANY_NAME=Volta Energia S.r.l.
# VITE_COMPANY_VAT=12948570155
# VITE_COMPANY_ADDRESS=Via Monte Napoleone 8, 20121 Milano (MI)
# VITE_COMPANY_REA=MI-2684910
# VITE_COMPANY_CAPITAL=€ 100.000,00 i.v.
